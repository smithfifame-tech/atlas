# Copie ce fichier en « .env » (l'installateur le fait pour toi).
# La clé peut aussi être saisie directement dans les Réglages de l'interface.

# Clé API Anthropic : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Modèle par défaut : claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
ASSISTANT_MODEL=claude-opus-5-5

# Nom affiché de ton assistant
ASSISTANT_NAME=Atlas

# Port local de l'interface (http://127.0.0.1:PORT)
ASSISTANT_PORT=8765
